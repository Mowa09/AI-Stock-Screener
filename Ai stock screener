<!DOCTYPE html>
<html lang="de" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StockVision PRO AI - 3000+ Real Market Screener & Developer Suite</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        tvDarkBg: '#000000',
                        tvCardBg: '#0B0E14',
                        tvHeaderBg: '#05070A',
                        tvBorder: '#1E222D',
                        tvHover: '#161A25',
                        tvAccent: '#2962FF',
                        tvBullish: '#00E676',
                        tvBearish: '#FF1744',
                        tvTextMuted: '#787B86',
                        tvTextBright: '#D1D4DC',
                        tvDevColor: '#9C27B0'
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #000000;
            color: #D1D4DC;
            font-family: -apple-system, BlinkMacSystemFont, "Trebuchet MS", Roboto, Ubuntu, sans-serif;
        }
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track { background: #000000; }
        ::-webkit-scrollbar-thumb { background: #1E222D; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #2A2E39; }
        @keyframes pulseGlow {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.4; }
        }
        .live-dot { animation: pulseGlow 1.5s infinite; }
    </style>
</head>
<body class="min-h-screen flex flex-col bg-tvDarkBg select-none overflow-x-hidden">

    <!-- Top Navigation Header -->
    <header class="bg-tvHeaderBg border-b border-tvBorder sticky top-0 z-50 text-xs">
        <div class="px-4 py-2.5 flex items-center justify-between">
            <div class="flex items-center space-x-4">
                <!-- Brand Status -->
                <div class="flex items-center space-x-2">
                    <div class="bg-emerald-500/10 border border-emerald-500/30 text-tvBullish font-black px-2.5 py-1 rounded text-xs tracking-wider flex items-center">
                        <span class="w-2 h-2 rounded-full bg-tvBullish mr-2 live-dot"></span>
                        STOCKVISION PRO <span class="text-white ml-1.5 text-[10px] bg-emerald-950/80 px-1.5 py-0.5 rounded border border-emerald-800">PRO ENGINE v3.5</span>
                    </div>
                </div>

                <!-- Navigation Quick Links -->
                <nav class="hidden md:flex items-center space-x-1 border-l border-tvBorder pl-3 text-xs">
                    <button onclick="showSection('screener')" class="px-2.5 py-1 rounded hover:bg-tvHover text-white font-medium flex items-center"><i class="fa-solid fa-chart-line mr-1.5 text-tvAccent"></i> Screener</button>
                    <button onclick="showSection('plugins')" class="px-2.5 py-1 rounded hover:bg-tvHover text-tvTextBright font-medium flex items-center"><i class="fa-solid fa-plug mr-1.5 text-amber-400"></i> Plugins Hub <span id="active-plugins-badge" class="ml-1 bg-amber-500/20 text-amber-300 text-[10px] px-1.5 rounded font-mono">3</span></button>
                    <button id="nav-dev-btn" onclick="showSection('dev')" class="px-2.5 py-1 rounded hover:bg-tvHover text-purple-400 font-medium flex items-center"><i class="fa-solid fa-code-branch mr-1.5"></i> Admin & Entwickler Modus</button>
                </nav>
            </div>

            <!-- Controls & Profile Header Section -->
            <div class="flex items-center space-x-3">
                <div class="hidden lg:flex items-center space-x-1.5 text-[11px] text-tvTextMuted border-r border-tvBorder pr-3">
                    <i class="fa-regular fa-clock"></i>
                    <span>Letzter Audit:</span>
                    <span id="last-update-time" class="text-white font-mono font-bold">--:--:--</span>
                </div>

                <!-- Auto Refresh Interval Selector -->
                <div class="flex items-center space-x-1.5 bg-tvCardBg border border-tvBorder px-2.5 py-1 rounded">
                    <i class="fa-solid fa-clock-rotate-left text-tvAccent text-xs"></i>
                    <select id="select-refresh-interval" onchange="changeAutoRefreshRate()" class="bg-transparent text-white text-[11px] focus:outline-none font-medium cursor-pointer">
                        <option value="0" class="bg-black">Manuell</option>
                        <option value="5" class="bg-black">Alle 5 Min.</option>
                        <option value="10" class="bg-black" selected>Alle 10 Min.</option>
                    </select>
                    <span id="next-refresh-timer" class="text-[10px] font-mono text-tvAccent font-bold min-w-[30px] text-right">--:--</span>
                </div>

                <!-- Trigger Scan -->
                <button id="btn-scan" onclick="startScanner()" class="bg-tvAccent hover:bg-blue-600 text-white px-3 py-1.5 rounded font-bold text-xs transition flex items-center shadow-lg shadow-blue-500/20">
                    <i class="fa-solid fa-bolt mr-1.5" id="scan-icon"></i>
                    <span id="scan-btn-text">Aktien Scannen</span>
                </button>

                <!-- User Profile / Auth Button -->
                <button id="btn-user-auth" onclick="openAuthModal()" class="bg-tvCardBg hover:bg-tvHover border border-tvBorder text-white px-3 py-1.5 rounded font-semibold text-xs transition flex items-center space-x-2">
                    <span id="user-status-dot" class="w-2 h-2 rounded-full bg-slate-500"></span>
                    <span id="user-display-name">Anmelden</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Dynamic Content Container -->
    <main class="flex-grow p-3 md:p-4 max-w-[1920px] mx-auto w-full flex flex-col space-y-3">

        <!-- Active Plugins Bar (User friendly plugin quick status) -->
        <div id="plugins-banner" class="bg-tvCardBg border border-tvBorder/80 rounded-lg p-2.5 flex flex-wrap items-center justify-between text-xs gap-2">
            <div class="flex items-center space-x-2">
                <span class="bg-amber-500/10 border border-amber-500/30 text-amber-400 text-[10px] font-bold px-2 py-0.5 rounded flex items-center">
                    <i class="fa-solid fa-puzzle-piece mr-1"></i> AKTIVE PLUGINS:
                </span>
                <div id="active-plugins-pills" class="flex flex-wrap gap-1.5">
                    <!-- Dynamic Plugin Badges -->
                </div>
            </div>
            <button onclick="showSection('plugins')" class="text-tvAccent hover:underline text-[11px] font-medium flex items-center">
                Plugins verwalten & hinzufügen <i class="fa-solid fa-arrow-right ml-1"></i>
            </button>
        </div>

        <!-- VIEW 1: SCREENER MAIN VIEW -->
        <div id="view-screener" class="space-y-3">

            <!-- Global Market Environment Radar Banner -->
            <div class="bg-tvCardBg border border-tvBorder rounded-lg p-3 grid grid-cols-2 md:grid-cols-4 gap-3 text-xs">
                <div class="bg-black/60 border border-tvBorder/70 p-2.5 rounded flex items-center space-x-3">
                    <div class="w-8 h-8 rounded-full bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-tvBullish text-sm">
                        <i class="fa-solid fa-gauge-high"></i>
                    </div>
                    <div>
                        <div class="text-[10px] text-tvTextMuted uppercase font-bold">Marktumgebung (Environment)</div>
                        <div class="text-white font-bold font-mono text-xs flex items-center">
                            Bullisch <span class="ml-1 text-[10px] text-tvBullish bg-emerald-950 px-1.5 rounded">Risk-On</span>
                        </div>
                    </div>
                </div>

                <div class="bg-black/60 border border-tvBorder/70 p-2.5 rounded flex items-center space-x-3">
                    <div class="w-8 h-8 rounded-full bg-blue-500/10 border border-blue-500/30 flex items-center justify-center text-tvAccent text-sm">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>
                    <div>
                        <div class="text-[10px] text-tvTextMuted uppercase font-bold">VIX Volatilitätsindex</div>
                        <div class="text-white font-bold font-mono text-xs">
                            14.20 <span class="text-tvBullish text-[10px] ml-1">(-2.4% Stabil)</span>
                        </div>
                    </div>
                </div>

                <div class="bg-black/60 border border-tvBorder/70 p-2.5 rounded flex items-center space-x-3">
                    <div class="w-8 h-8 rounded-full bg-purple-500/10 border border-purple-500/30 flex items-center justify-center text-purple-400 text-sm">
                        <i class="fa-solid fa-building-columns"></i>
                    </div>
                    <div>
                        <div class="text-[10px] text-tvTextMuted uppercase font-bold">Institutionelles Smart Money</div>
                        <div class="text-purple-300 font-bold font-mono text-xs">
                            Akkumulation <i class="fa-solid fa-arrow-trend-up text-tvBullish ml-0.5"></i>
                        </div>
                    </div>
                </div>

                <div class="bg-black/60 border border-tvBorder/70 p-2.5 rounded flex items-center space-x-3">
                    <div class="w-8 h-8 rounded-full bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 text-sm">
                        <i class="fa-solid fa-microchip"></i>
                    </div>
                    <div>
                        <div class="text-[10px] text-tvTextMuted uppercase font-bold">KI KI-Filter-Qualität</div>
                        <div class="text-amber-300 font-bold font-mono text-xs">
                            94.8% Treffer-Konfidenz
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Top Controls Panel -->
            <div class="bg-tvCardBg border border-tvBorder rounded-lg p-3.5 space-y-3">
                
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-2 pb-2 border-b border-tvBorder">
                    <div class="flex items-center space-x-3 w-full md:w-auto">
                        <div id="scanner-status-tag" class="text-[10px] bg-emerald-500/20 text-tvBullish border border-emerald-500/30 px-2.5 py-1 rounded font-mono font-bold">
                            Bereit
                        </div>
                        <div class="text-xs text-white font-medium">
                            Verifizierte Real-Market Engine: <span id="scan-count-text" class="text-tvAccent font-mono font-bold">3,240 / 3,240</span> Ticker im Pool
                        </div>
                    </div>

                    <!-- Metrics -->
                    <div class="flex items-center space-x-3 text-xs font-mono w-full md:w-auto justify-between md:justify-end">
                        <div class="bg-black border border-tvBorder px-3 py-1 rounded">
                            <span class="text-tvTextMuted text-[10px] uppercase font-sans">Ergebnisse:</span>
                            <span id="stat-total" class="font-bold text-white ml-1">3,240</span>
                        </div>
                        <div class="bg-emerald-950/40 border border-emerald-900/50 px-3 py-1 rounded">
                            <span class="text-tvBullish text-[10px] uppercase font-sans">Kauf (BUY):</span>
                            <span id="stat-bullish" class="font-bold text-tvBullish ml-1">1,642</span>
                        </div>
                        <div class="bg-rose-950/40 border border-rose-900/50 px-3 py-1 rounded">
                            <span class="text-tvBearish text-[10px] uppercase font-sans">Verkauf (SELL):</span>
                            <span id="stat-bearish" class="font-bold text-tvBearish ml-1">1,598</span>
                        </div>
                    </div>
                </div>

                <!-- Search & Filters -->
                <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-center">
                    
                    <!-- Search Input for FULL NAMES & TICKERS -->
                    <div class="md:col-span-5 relative">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-tvTextMuted text-xs"></i>
                        <input type="text" id="input-live-search" oninput="handleLiveSearchInput()" placeholder="Suche nach vollem Namen oder Ticker (z. B. NVIDIA Corporation, Tesla, Apple, Bitcoin, SAP)..." class="w-full bg-black border border-tvAccent/60 rounded-md pl-9 pr-8 py-2 text-xs text-white placeholder-tvTextMuted focus:outline-none focus:border-tvAccent focus:ring-1 focus:ring-tvAccent font-sans">
                        <button onclick="clearSearchInput()" id="btn-clear-search" class="hidden absolute right-2.5 top-2 text-tvTextMuted hover:text-white text-xs">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>

                    <!-- Signal Filter -->
                    <div class="md:col-span-2">
                        <select id="select-signal-filter" onchange="filterAndRenderList()" class="w-full bg-black border border-tvBorder rounded-md p-2 text-xs text-white focus:outline-none focus:border-tvAccent">
                            <option value="ALL">Alle Signale (BUY & SELL)</option>
                            <option value="BUY">Nur Kauf (BUY)</option>
                            <option value="SELL">Nur Verkauf (SELL)</option>
                        </select>
                    </div>

                    <!-- Sector Filter -->
                    <div class="md:col-span-2">
                        <select id="select-market-filter" onchange="filterAndRenderList()" class="w-full bg-black border border-tvBorder rounded-md p-2 text-xs text-white focus:outline-none focus:border-tvAccent">
                            <option value="ALL">Alle Märkte & Sektoren</option>
                            <option value="Technologie">Technologie & Software</option>
                            <option value="Crypto">Crypto & Blockchain</option>
                            <option value="Automobil">Automobil & Mobility</option>
                            <option value="Finanzen">Finanzen & Banken</option>
                            <option value="Gesundheit">Gesundheit & Pharma</option>
                            <option value="Energie">Energie & Rohstoffe</option>
                            <option value="Industrie">Industrie & Konsum</option>
                        </select>
                    </div>

                    <!-- Min Probability Slider -->
                    <div class="md:col-span-3 bg-black border border-tvBorder p-1.5 rounded-md px-3">
                        <div class="flex justify-between text-[10px] text-tvTextMuted mb-0.5">
                            <span>Min. Zweitprüfungs-Konfidenz:</span>
                            <span id="label-min-prob" class="text-tvAccent font-bold font-mono">60%</span>
                        </div>
                        <input type="range" id="input-min-prob" min="50" max="95" value="60" class="w-full accent-tvAccent h-1 bg-tvBorder rounded cursor-pointer" oninput="updateProbLabel(this.value)">
                    </div>

                </div>

                <!-- Views Switcher Tab -->
                <div class="flex items-center justify-between pt-1 border-t border-tvBorder/50">
                    <div class="flex items-center space-x-2">
                        <button id="tab-all-stocks" onclick="switchViewTab('ALL')" class="px-3.5 py-1.5 text-xs font-bold bg-tvAccent text-white rounded transition flex items-center">
                            <i class="fa-solid fa-list-check mr-2"></i> Alle echten Marktmuster (<span id="all-count">3,240</span>)
                        </button>
                        <button id="tab-watchlist" onclick="switchViewTab('WATCHLIST')" class="px-3.5 py-1.5 text-xs font-bold bg-tvBorder text-tvTextMuted hover:text-white rounded transition flex items-center">
                            <i class="fa-solid fa-star text-amber-400 mr-2"></i> Meine Watchlist (<span id="watchlist-count">0</span>)
                        </button>
                    </div>

                    <div class="text-[11px] text-tvTextMuted hidden sm:flex items-center">
                        <i class="fa-solid fa-circle-check text-emerald-400 mr-1.5"></i> Dual KI Zweitprüfung aktiviert
                    </div>
                </div>
            </div>

            <!-- Main Stock Table -->
            <div class="bg-tvCardBg border border-tvBorder rounded-lg p-3.5 flex-grow flex flex-col min-h-[550px]">
                
                <div class="flex justify-between items-center mb-2 pb-2 border-b border-tvBorder text-xs text-tvTextMuted">
                    <span class="flex items-center text-white font-bold">
                        <i class="fa-solid fa-shield-halved text-emerald-400 mr-2"></i>
                        Verifizierte KI-Signale & Ticker (Gefunden: <span id="list-count" class="text-tvAccent font-bold font-mono ml-1">0</span>)
                    </span>
                    <span class="text-[11px] text-tvTextMuted">
                        Klicke auf <i class="fa-solid fa-microchip text-tvAccent mx-0.5"></i> für Zweitprüfungs-Details
                    </span>
                </div>

                <!-- Table -->
                <div class="overflow-y-auto overflow-x-auto flex-grow max-h-[65vh] border border-tvBorder rounded">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead class="bg-black sticky top-0 z-20 text-tvTextMuted text-[10px] uppercase font-bold border-b border-tvBorder tracking-wider">
                            <tr>
                                <th class="py-3 px-2 text-center w-8"><i class="fa-solid fa-star text-amber-400"></i></th>
                                <th class="py-3 px-3">Unternehmensname & Ticker</th>
                                <th class="py-3 px-3">Geprüftes Chartmuster</th>
                                <th class="py-3 px-3">Sektor</th>
                                <th class="py-3 px-3">Aktueller Kurs</th>
                                <th class="py-3 px-3 text-center">KI-Signal</th>
                                <th class="py-3 px-3 text-right">Konfidenz</th>
                                <th class="py-3 px-3 text-center">Zweitprüfung</th>
                                <th class="py-3 px-3 text-right">Take Profit (TP)</th>
                                <th class="py-3 px-3 text-right">Stop Loss (SL)</th>
                                <th class="py-3 px-3 text-center">Chart</th>
                            </tr>
                        </thead>
                        <tbody id="stock-table-body" class="divide-y divide-tvBorder/60">
                            <!-- Dynamic Content -->
                        </tbody>
                    </table>
                </div>

                <!-- Table Pagination -->
                <div class="flex flex-col sm:flex-row justify-between items-center pt-3 border-t border-tvBorder mt-2 text-xs text-tvTextMuted gap-2">
                    <div>
                        Zeige <span id="page-start-idx" class="text-white font-bold font-mono">1</span> - <span id="page-end-idx" class="text-white font-bold font-mono">50</span> von <span id="page-total-count" class="text-tvAccent font-bold font-mono">0</span> Einträgen
                    </div>
                    
                    <div class="flex items-center space-x-2">
                        <button onclick="changePage(-1)" id="btn-prev-page" class="bg-tvBorder hover:bg-slate-800 text-white px-3 py-1 rounded font-bold disabled:opacity-40 disabled:cursor-not-allowed">
                            <i class="fa-solid fa-chevron-left mr-1"></i> Zurück
                        </button>
                        <span class="font-mono">Seite <strong id="current-page-num" class="text-white">1</strong> von <strong id="max-page-num" class="text-white">1</strong></span>
                        <button onclick="changePage(1)" id="btn-next-page" class="bg-tvBorder hover:bg-slate-800 text-white px-3 py-1 rounded font-bold disabled:opacity-40 disabled:cursor-not-allowed">
                            Weiter <i class="fa-solid fa-chevron-right ml-1"></i>
                        </button>
                    </div>
                </div>

            </div>

        </div>

        <!-- VIEW 2: PLUGINS HUB -->
        <div id="view-plugins" class="hidden space-y-4">
            <div class="bg-tvCardBg border border-tvBorder rounded-lg p-5">
                <div class="flex justify-between items-center pb-4 border-b border-tvBorder">
                    <div>
                        <h2 class="text-lg font-bold text-white flex items-center">
                            <i class="fa-solid fa-puzzle-piece text-amber-400 mr-2.5"></i> StockVision Plugin Store & Verwalter
                        </h2>
                        <p class="text-xs text-tvTextMuted">Erweitere deinen Screener mit mächtigen Analyse- und Trading-Modulen.</p>
                    </div>
                    <button onclick="showSection('screener')" class="bg-tvBorder hover:bg-slate-800 text-white text-xs px-3 py-1.5 rounded">
                        <i class="fa-solid fa-arrow-left mr-1"></i> Zurück zum Screener
                    </button>
                </div>

                <div id="plugins-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 pt-4">
                    <!-- Dynamic Plugins List -->
                </div>
            </div>
        </div>

        <!-- VIEW 3: ADMIN & DEVELOPER SUITE (ADMIN PANEL) -->
        <div id="view-dev" class="hidden space-y-4">
            <div class="bg-tvCardBg border border-purple-900/50 rounded-lg p-5 space-y-5">
                <div class="flex justify-between items-center pb-4 border-b border-tvBorder">
                    <div>
                        <h2 class="text-lg font-bold text-white flex items-center">
                            <i class="fa-solid fa-code-branch text-purple-400 mr-2.5"></i> Entwickler & Administrator Dashboard
                        </h2>
                        <p class="text-xs text-tvTextMuted">Webseiten-Besitzer Konsole: Verwalte Ticker, passe Signale an und erstelle eigene Plugins.</p>
                    </div>
                    <div class="flex items-center space-x-2">
                        <span id="dev-access-badge" class="bg-purple-900/40 text-purple-300 border border-purple-500/30 text-[10px] font-bold px-2.5 py-1 rounded">
                            <i class="fa-solid fa-lock mr-1"></i> Admin Modus
                        </span>
                        <button onclick="showSection('screener')" class="bg-tvBorder hover:bg-slate-800 text-white text-xs px-3 py-1.5 rounded">
                            Screener Ansicht
                        </button>
                    </div>
                </div>

                <!-- Admin Action 1: Add/Edit Ticker -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <div class="bg-black/60 border border-tvBorder p-4 rounded-lg space-y-3">
                        <h3 class="text-sm font-bold text-white flex items-center">
                            <i class="fa-solid fa-plus-circle text-emerald-400 mr-2"></i> Neue Aktie / Asset hinzufügen
                        </h3>
                        <form onsubmit="handleDevAddTicker(event)" class="space-y-2.5 text-xs">
                            <div class="grid grid-cols-2 gap-2">
                                <div>
                                    <label class="block text-tvTextMuted text-[10px] uppercase font-bold mb-1">Ticker Symbol</label>
                                    <input type="text" id="dev-input-symbol" required placeholder="z. B. RHM.DE" class="w-full bg-tvCardBg border border-tvBorder rounded p-2 text-white focus:outline-none focus:border-tvAccent font-mono">
                                </div>
                                <div>
                                    <label class="block text-tvTextMuted text-[10px] uppercase font-bold mb-1">Unternehmensname (Ausschreiben)</label>
                                    <input type="text" id="dev-input-name" required placeholder="Rheinmetall AG" class="w-full bg-tvCardBg border border-tvBorder rounded p-2 text-white focus:outline-none focus:border-tvAccent">
                                </div>
                            </div>

                            <div class="grid grid-cols-3 gap-2">
                                <div>
                                    <label class="block text-tvTextMuted text-[10px] uppercase font-bold mb-1">Sektor</label>
                                    <select id="dev-input-sector" class="w-full bg-tvCardBg border border-tvBorder rounded p-2 text-white focus:outline-none focus:border-tvAccent">
                                        <option value="Technologie">Technologie</option>
                                        <option value="Industrie">Industrie</option>
                                        <option value="Crypto">Crypto</option>
                                        <option value="Automobil">Automobil</option>
                                        <option value="Finanzen">Finanzen</option>
                                        <option value="Gesundheit">Gesundheit</option>
                                        <option value="Energie">Energie</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-tvTextMuted text-[10px] uppercase font-bold mb-1">Preis ($/€)</label>
                                    <input type="number" step="0.01" id="dev-input-price" required placeholder="520.00" class="w-full bg-tvCardBg border border-tvBorder rounded p-2 text-white focus:outline-none focus:border-tvAccent font-mono">
                                </div>
                                <div>
                                    <label class="block text-tvTextMuted text-[10px] uppercase font-bold mb-1">KI Signal</label>
                                    <select id="dev-input-signal" class="w-full bg-tvCardBg border border-tvBorder rounded p-2 text-white focus:outline-none focus:border-tvAccent">
                                        <option value="BUY">BUY (Kauf)</option>
                                        <option value="SELL">SELL (Verkauf)</option>
                                    </select>
                                </div>
                            </div>

                            <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-2 rounded transition text-xs mt-1">
                                <i class="fa-solid fa-database mr-1"></i> Asset im System Speichern
                            </button>
                        </form>
                    </div>

