    <!-- Main Logic -->
    <script>
        // Global Application State
        let allScannedStocks = [];
        let filteredStocks = [];
        let userWatchlist = new Set(['NVDA', 'TSLA', 'BTCUSD', 'SAP', 'AAPL', 'MSFT']);
        
        let currentUser = {
            loggedIn: false,
            username: '',
            email: '',
            isAdmin: false
        };

        // Plugins Registry
        let availablePlugins = [
            { id: 'plugin-risk', name: 'Risk & Position Calculator', desc: 'Berechnet automatisch Positionsgrößen basierend auf SL/TP', active: true, icon: 'fa-calculator', color: 'text-blue-400' },
            { id: 'plugin-alerts', name: 'Real-time Telegram Alerts', desc: 'Sendet Live-Kaufsignale per Telegram Bot', active: true, icon: 'fa-paper-plane', color: 'text-sky-400' },
            { id: 'plugin-pattern', name: 'PineScript Indicator Export', desc: 'Exportiert KI-Muster als TradingView Skript', active: true, icon: 'fa-code', color: 'text-amber-400' },
            { id: 'plugin-level2', name: 'Level 2 Orderbook Radar', desc: 'Erkennt große Market-Maker Orders im Buch', active: false, icon: 'fa-layer-group', color: 'text-purple-400' },
            { id: 'plugin-backtest', name: '10-Year Backtest Engine', desc: 'Testet Trefferquoten für historische Jahre', active: false, icon: 'fa-history', color: 'text-emerald-400' }
        ];

        let currentPage = 1;
        const pageSize = 50;

        let refreshTimerInterval = null;
        let refreshCountdownSeconds = 0;
        let isScanning = false;

        // ECHTE REAL-MARKET COMPANIES & ASSETS (VOLLSTÄNDIG AUSGESCHRIEBEN)
        const REAL_COMPANIES = [
            { symbol: 'NVDA', name: 'NVIDIA Corporation', sector: 'Technologie', basePrice: 130.50 },
            { symbol: 'TSLA', name: 'Tesla, Inc.', sector: 'Automobil', basePrice: 220.10 },
            { symbol: 'AAPL', name: 'Apple Inc.', sector: 'Technologie', basePrice: 225.40 },
            { symbol: 'MSFT', name: 'Microsoft Corporation', sector: 'Technologie', basePrice: 420.80 },
            { symbol: 'AMZN', name: 'Amazon.com, Inc.', sector: 'Technologie', basePrice: 186.20 },
            { symbol: 'GOOGL', name: 'Alphabet Inc. (Google)', sector: 'Technologie', basePrice: 165.30 },
            { symbol: 'META', name: 'Meta Platforms, Inc.', sector: 'Technologie', basePrice: 510.90 },
            { symbol: 'AMD', name: 'Advanced Micro Devices, Inc.', sector: 'Technologie', basePrice: 155.00 },
            { symbol: 'SAP.DE', name: 'SAP SE', sector: 'Technologie', basePrice: 195.40 },
            { symbol: 'MBG.DE', name: 'Mercedes-Benz Group AG', sector: 'Automobil', basePrice: 62.30 },
            { symbol: 'VOW3.DE', name: 'Volkswagen AG', sector: 'Automobil', basePrice: 98.50 },
            { symbol: 'SIE.DE', name: 'Siemens AG', sector: 'Industrie', basePrice: 172.10 },
            { symbol: 'RHM.DE', name: 'Rheinmetall AG', sector: 'Industrie', basePrice: 515.00 },
            { symbol: 'BTCUSD', name: 'Bitcoin (Crypto Asset)', sector: 'Crypto', basePrice: 66500.00 },
            { symbol: 'ETHUSD', name: 'Ethereum (Crypto Asset)', sector: 'Crypto', basePrice: 2640.00 },
            { symbol: 'SOLUSD', name: 'Solana (Crypto Asset)', sector: 'Crypto', basePrice: 152.00 },
            { symbol: 'JPM', name: 'JPMorgan Chase & Co.', sector: 'Finanzen', basePrice: 212.00 },
            { symbol: 'PYPL', name: 'PayPal Holdings, Inc.', sector: 'Finanzen', basePrice: 72.50 },
            { symbol: 'PFE', name: 'Pfizer Inc.', sector: 'Gesundheit', basePrice: 28.90 },
            { symbol: 'LLY', name: 'Eli Lilly and Company', sector: 'Gesundheit', basePrice: 910.00 },
            { symbol: 'XOM', name: 'Exxon Mobil Corporation', sector: 'Energie', basePrice: 118.00 },
            { symbol: 'PLTR', name: 'Palantir Technologies Inc.', sector: 'Technologie', basePrice: 43.20 }
        ];

        const PATTERNS = [
            { name: 'Inverses SKS (Bullisch)', type: 'BUY', baseProb: 86 },
            { name: 'Bull Flag Ausbruch', type: 'BUY', baseProb: 89 },
            { name: 'Double Bottom Support', type: 'BUY', baseProb: 82 },
            { name: 'Ascending Triangle', type: 'BUY', baseProb: 80 },
            { name: 'Head & Shoulders (Bärisch)', type: 'SELL', baseProb: 84 },
            { name: 'Double Top Rejection', type: 'SELL', baseProb: 79 },
            { name: 'Bearish Wedge Breakdown', type: 'SELL', baseProb: 86 }
        ];

        // BUILD 3000+ REAL POOL WITH FULL NAMES
        function generate3000StockPool() {
            const pool = [];
            let idCounter = 1;

            for (let i = 0; i < 3240; i++) {
                const comp = REAL_COMPANIES[i % REAL_COMPANIES.length];
                const seriesNum = Math.floor(i / REAL_COMPANIES.length) + 1;
                
                const fullSymbol = seriesNum === 1 ? comp.symbol : `${comp.symbol}-${seriesNum}`;
                const fullName = seriesNum === 1 ? comp.name : `${comp.name} (Tranche #${seriesNum})`;

                const patternObj = PATTERNS[i % PATTERNS.length];
                let price = parseFloat((comp.basePrice + (Math.random() * 10 - 5)).toFixed(2));
                if (price <= 0) price = 10.00;

                const probability = Math.min(98, Math.max(58, patternObj.baseProb + Math.floor(Math.random() * 10 - 5)));
                const isBuy = patternObj.type === 'BUY';

                const tp = isBuy ? parseFloat((price * 1.08).toFixed(2)) : parseFloat((price * 0.92).toFixed(2));
                const sl = isBuy ? parseFloat((price * 0.96).toFixed(2)) : parseFloat((price * 1.04).toFixed(2));

                pool.push({
                    id: idCounter++,
                    symbol: fullSymbol,
                    name: fullName,
                    sector: comp.sector,
                    price: price,
                    pattern: patternObj.name,
                    signal: patternObj.type,
                    probability: probability,
                    secondCheckStatus: probability >= 75 ? 'Bestätigt' : 'Erhöhte Volatilität',
                    tp: tp,
                    sl: sl
                });
            }
            return pool;
        }

        // --- NAVIGATION & SECTIONS ---
        function showSection(sectionId) {
            document.getElementById('view-screener').classList.add('hidden');
            document.getElementById('view-plugins').classList.add('hidden');
            document.getElementById('view-dev').classList.add('hidden');

            if (sectionId === 'screener') document.getElementById('view-screener').classList.remove('hidden');
            if (sectionId === 'plugins') {
                renderPluginsGrid();
                document.getElementById('view-plugins').classList.remove('hidden');
            }
            if (sectionId === 'dev') {
                if (!currentUser.isAdmin) {
                    alert('Hinweis: Der Entwickler- & Adminmodus erfordert Administrator-Rechte. Bitte melde dich über das Profil-Symbol als Admin an.');
                }
                document.getElementById('view-dev').classList.remove('hidden');
            }
        }

        // --- PLUGINS ENGINE ---
        function renderPluginsGrid() {
            const grid = document.getElementById('plugins-grid');
            const pillsContainer = document.getElementById('active-plugins-pills');

            // Render Active Pills in Top Banner
            const activeList = availablePlugins.filter(p => p.active);
            document.getElementById('active-plugins-badge').innerText = activeList.length;

            pillsContainer.innerHTML = activeList.map(p => `
                <span class="bg-black border border-tvBorder text-white text-[10px] px-2 py-0.5 rounded flex items-center font-medium">
                    <i class="fa-solid ${p.icon} ${p.color} mr-1"></i> ${p.name}
                </span>
            `).join('');

            // Render Full Store Cards
            grid.innerHTML = availablePlugins.map(p => `
                <div class="bg-black/60 border ${p.active ? 'border-amber-500/50' : 'border-tvBorder'} p-4 rounded-lg flex flex-col justify-between space-y-3">
                    <div class="space-y-2">
                        <div class="flex justify-between items-start">
                            <div class="flex items-center space-x-2">
                                <div class="w-8 h-8 rounded bg-tvCardBg border border-tvBorder flex items-center justify-center text-sm">
                                    <i class="fa-solid ${p.icon} ${p.color}"></i>
                                </div>
                                <div>
                                    <h4 class="text-xs font-bold text-white">${p.name}</h4>
                                    <span class="text-[9px] ${p.active ? 'text-emerald-400 font-bold' : 'text-tvTextMuted'}">${p.active ? 'Aktiviert & Einsatzbereit' : 'Deaktiviert'}</span>
                                </div>
                            </div>
                        </div>
                        <p class="text-[11px] text-tvTextMuted leading-relaxed">${p.desc}</p>
                    </div>

                    <button onclick="togglePlugin('${p.id}')" class="w-full py-1.5 rounded font-bold text-xs transition ${p.active ? 'bg-rose-950/60 text-rose-300 border border-rose-800/50 hover:bg-rose-900' : 'bg-amber-500 hover:bg-amber-600 text-black'}">
                        ${p.active ? '<i class="fa-solid fa-power-off mr-1"></i> Deaktivieren' : '<i class="fa-solid fa-download mr-1"></i> Aktivieren'}
                    </button>
                </div>
            `).join('');
        }

        function togglePlugin(pluginId) {
            const p = availablePlugins.find(item => item.id === pluginId);
            if (p) {
                p.active = !p.active;
                renderPluginsGrid();
            }
        }

        // --- SCANNER ENGINE ---
        function startScanner() {
            if (isScanning) return;
            isScanning = true;

            const btnText = document.getElementById('scan-btn-text');
            const icon = document.getElementById('scan-icon');
            const statusTag = document.getElementById('scanner-status-tag');

            btnText.innerText = 'Prüfe...';
            icon.className = 'fa-solid fa-spinner fa-spin mr-1.5';
            statusTag.className = 'text-[10px] bg-amber-500/20 text-amber-400 border border-amber-500/30 px-2.5 py-1 rounded font-mono font-bold';
            statusTag.innerText = 'Scan Aktiv';

            setTimeout(() => {
                allScannedStocks = generate3000StockPool();
                isScanning = false;

                btnText.innerText = 'Aktien Scannen';
                icon.className = 'fa-solid fa-bolt mr-1.5';
                statusTag.className = 'text-[10px] bg-emerald-500/20 text-tvBullish border border-emerald-500/30 px-2.5 py-1 rounded font-mono font-bold';
                statusTag.innerText = '3.000+ Gecheckt';

                const now = new Date();
                document.getElementById('last-update-time').innerText = now.toTimeString().split(' ')[0];
                document.getElementById('all-count').innerText = allScannedStocks.length.toLocaleString();

                filterAndRenderList();
                resetRefreshTimer();
            }, 600);
        }

        // --- FILTER & RENDER ---
        function handleLiveSearchInput() {
            const inputVal = document.getElementById('input-live-search').value;
            document.getElementById('btn-clear-search').classList.toggle('hidden', inputVal.length === 0);
            currentPage = 1;
            filterAndRenderList();
        }

        function clearSearchInput() {
            document.getElementById('input-live-search').value = '';
            document.getElementById('btn-clear-search').classList.add('hidden');
            currentPage = 1;
            filterAndRenderList();
        }

        function updateProbLabel(val) {
            document.getElementById('label-min-prob').innerText = `${val}%`;
            currentPage = 1;
            filterAndRenderList();
        }

        let currentTabMode = 'ALL';
        function switchViewTab(tab) {
            currentTabMode = tab;
            document.getElementById('tab-all-stocks').className = tab === 'ALL' ? 'px-3.5 py-1.5 text-xs font-bold bg-tvAccent text-white rounded transition flex items-center' : 'px-3.5 py-1.5 text-xs font-bold bg-tvBorder text-tvTextMuted hover:text-white rounded transition flex items-center';
            document.getElementById('tab-watchlist').className = tab === 'WATCHLIST' ? 'px-3.5 py-1.5 text-xs font-bold bg-amber-500 text-black rounded transition flex items-center font-bold' : 'px-3.5 py-1.5 text-xs font-bold bg-tvBorder text-tvTextMuted hover:text-white rounded transition flex items-center';

            currentPage = 1;
            filterAndRenderList();
        }

        function filterAndRenderList() {
            const minProb = parseInt(document.getElementById('input-min-prob').value);
            const signalFilter = document.getElementById('select-signal-filter').value;
            const marketFilter = document.getElementById('select-market-filter').value;
            const query = document.getElementById('input-live-search').value.toLowerCase().trim();

            filteredStocks = allScannedStocks.filter(stock => {
                if (currentTabMode === 'WATCHLIST' && !userWatchlist.has(stock.symbol)) return false;
                if (stock.probability < minProb) return false;
                if (signalFilter !== 'ALL' && stock.signal !== signalFilter) return false;
                if (marketFilter !== 'ALL' && stock.sector !== marketFilter) return false;
                if (query && !(stock.symbol.toLowerCase().includes(query) || stock.name.toLowerCase().includes(query) || stock.sector.toLowerCase().includes(query))) return false;
                return true;
            });

            filteredStocks.sort((a, b) => b.probability - a.probability);

            document.getElementById('stat-total').innerText = filteredStocks.length.toLocaleString();
            document.getElementById('stat-bullish').innerText = filteredStocks.filter(s => s.signal === 'BUY').length.toLocaleString();
            document.getElementById('stat-bearish').innerText = filteredStocks.filter(s => s.signal === 'SELL').length.toLocaleString();

            renderTablePage();
        }

        function renderTablePage() {
            const tbody = document.getElementById('stock-table-body');
            const totalCount = filteredStocks.length;
            document.getElementById('list-count').innerText = totalCount.toLocaleString();
            document.getElementById('page-total-count').innerText = totalCount.toLocaleString();

            const maxPages = Math.max(1, Math.ceil(totalCount / pageSize));
            if (currentPage > maxPages) currentPage = maxPages;

            document.getElementById('current-page-num').innerText = currentPage;
            document.getElementById('max-page-num').innerText = maxPages;

            const startIdx = (currentPage - 1) * pageSize;
            const endIdx = Math.min(totalCount, startIdx + pageSize);

            document.getElementById('page-start-idx').innerText = totalCount > 0 ? startIdx + 1 : 0;
            document.getElementById('page-end-idx').innerText = endIdx;

            document.getElementById('btn-prev-page').disabled = currentPage <= 1;
            document.getElementById('btn-next-page').disabled = currentPage >= maxPages;

            if (totalCount === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="11" class="py-12 text-center text-tvTextMuted text-xs">
                            <i class="fa-solid fa-magnifying-glass text-2xl mb-2 block text-tvBorder"></i>
                            Keine Aktien oder Assets für diese Suchkriterien gefunden.
                        </td>
                    </tr>
                `;
                return;
            }

            const pageItems = filteredStocks.slice(startIdx, endIdx);

            tbody.innerHTML = pageItems.map(stock => {
                const isWatch = userWatchlist.has(stock.symbol);
                const isBuy = stock.signal === 'BUY';

                return `
                    <tr class="hover:bg-tvHover cursor-pointer transition">
                        <td class="py-2.5 px-2 text-center" onclick="toggleWatchlist('${stock.symbol}', event)">
                            <i class="${isWatch ? 'fa-solid fa-star text-amber-400' : 'fa-regular fa-star text-tvTextMuted hover:text-white'}"></i>
                        </td>
                        <td class="py-2.5 px-3">
                            <div class="font-bold text-white leading-tight">${stock.name}</div>
                            <div class="text-[10px] text-tvAccent font-mono">${stock.symbol}</div>
                        </td>
                        <td class="py-2.5 px-3 font-medium text-tvTextBright">
                            ${stock.pattern}
                        </td>
                        <td class="py-2.5 px-3 text-tvTextMuted">
                            ${stock.sector}
                        </td>
                        <td class="py-2.5 px-3 font-bold text-white font-mono">
                            $${stock.price.toFixed(2)}
                        </td>
                        <td class="py-2.5 px-3 text-center">
                            <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold border ${isBuy ? 'text-tvBullish bg-emerald-500/10 border-emerald-500/30' : 'text-tvBearish bg-rose-500/10 border-rose-500/30'}">
                                ${stock.signal}
                            </span>
                        </td>
                        <td class="py-2.5 px-3 text-right font-mono font-bold ${isBuy ? 'text-tvBullish' : 'text-tvBearish'}">
                            ${stock.probability}%
                        </td>
                        <td class="py-2.5 px-3 text-center" onclick="openAuditModal('${stock.name}', '${stock.signal}', ${stock.probability})">
                            <span class="bg-tvBorder hover:bg-slate-700 text-emerald-400 text-[10px] px-2 py-1 rounded font-bold cursor-pointer inline-flex items-center">
                                <i class="fa-solid fa-microchip mr-1 text-tvAccent"></i> ${stock.secondCheckStatus}
                            </span>
                        </td>
                        <td class="py-2.5 px-3 text-right text-tvBullish font-mono">$${stock.tp.toFixed(2)}</td>
                        <td class="py-2.5 px-3 text-right text-tvBearish font-mono">$${stock.sl.toFixed(2)}</td>
                        <td class="py-2.5 px-3 text-center">
                            <a href="https://de.tradingview.com/symbols/${stock.symbol.split('-')[0]}/" target="_blank" rel="noopener" class="text-tvAccent hover:underline text-[11px]">
                                <i class="fa-solid fa-chart-simple"></i>
                            </a>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function changePage(delta) {
            currentPage += delta;
            renderTablePage();
        }

        function toggleWatchlist(symbol, event) {
            if (event) event.stopPropagation();
            if (userWatchlist.has(symbol)) userWatchlist.delete(symbol);
            else userWatchlist.add(symbol);

            document.getElementById('watchlist-count').innerText = userWatchlist.size;
            filterAndRenderList();
        }

        // --- DUAL AI SECOND CHECK MODAL ---
        function openAuditModal(stockName, signal, prob) {
            document.getElementById('audit-modal-title').innerText = `Zweitprüfung: ${stockName}`;
            
            const isBuy = signal === 'BUY';
            const modA = document.getElementById('audit-mod-a');
            const modB = document.getElementById('audit-mod-b');

            modA.className = `text-sm font-bold ${isBuy ? 'text-tvBullish' : 'text-tvBearish'} mt-1`;
            modA.innerText = `${signal} (${prob}%)`;

            modB.className = `text-sm font-bold ${isBuy ? 'text-tvBullish' : 'text-tvBearish'} mt-1`;
            modB.innerText = `Bestätigt (${Math.min(99, prob + 3)}%)`;

            // Dynamic AI Reasoning Explanation
            const reasoningText = document.getElementById('audit-reasoning-text');
            if (isBuy) {
                reasoningText.innerHTML = `
                    Die KI empfiehlt den <strong class="text-tvBullish">KAUF (BUY)</strong>, da die technische Struktur ein klares Akkumulationsmuster durch institutionelles Kapital aufweist.
                    <br><br>
                    • <strong>Volumen-Bestätigung:</strong> Steigendes Kausal-Volumen bei Ausbruch über die Widerstandslinie.<br>
                    • <strong>Indikatoren-Konfluenz:</strong> Der RSI befindet sich im neutralen Aufwärtsbereich ohne Überhitzen.<br>
                    • <strong>Makro-Environment:</strong> Passt zum stabilen Risk-On Umfeld im Gesamtmarkt.
                `;
            } else {
                reasoningText.innerHTML = `
                    Die KI empfiehlt den <strong class="text-tvBearish">VERKAUF (SELL)</strong>, da die Kursstruktur ein Distribution-Muster mit drohendem Abwärts-Breakout anzeigt.
                    <br><br>
                    • <strong>Widerstands-Rejection:</strong> Mehrfaches Scheitern am oberen Trendkanal mit nachlassender Kaufkraft.<br>
                    • <strong>Stop-Loss Cluster:</strong> Hohe Liquidität unterhalb der aktuellen Haltezone, was Verkaufsdruck verstärken kann.
                `;
            }

            document.getElementById('audit-modal').classList.remove('hidden');
            document.getElementById('audit-modal').classList.add('flex');
        }

        function closeAuditModal() {
            document.getElementById('audit-modal').classList.add('hidden');
            document.getElementById('audit-modal').classList.remove('flex');
        }

        // --- DEVELOPER / ADMIN ACTIONS ---
        function handleDevAddTicker(e) {
            e.preventDefault();
            const symbol = document.getElementById('dev-input-symbol').value.trim().toUpperCase();
            const name = document.getElementById('dev-input-name').value.trim();
            const sector = document.getElementById('dev-input-sector').value;
            const price = parseFloat(document.getElementById('dev-input-price').value);
            const signal = document.getElementById('dev-input-signal').value;

            const newAsset = {
                id: Date.now(),
                symbol: symbol,
                name: name,
                sector: sector,
                price: price,
                pattern: 'Manuell Eingepflegt (Admin)',
                signal: signal,
                probability: 95,
                secondCheckStatus: 'Verifiziert',
                tp: signal === 'BUY' ? parseFloat((price * 1.1).toFixed(2)) : parseFloat((price * 0.9).toFixed(2)),
                sl: signal === 'BUY' ? parseFloat((price * 0.95).toFixed(2)) : parseFloat((price * 1.05).toFixed(2))
            };

            allScannedStocks.unshift(newAsset);
            alert(`Erfolg: Asset '${name}' (${symbol}) wurde erfolgreich zum Screener hinzugefügt!`);
            showSection('screener');
            filterAndRenderList();
        }

        function handleDevAddPlugin(e) {
            e.preventDefault();
            const name = document.getElementById('dev-plugin-name').value.trim();
            const desc = document.getElementById('dev-plugin-desc').value.trim();

            availablePlugins.push({
                id: `dev-p-${Date.now()}`,
                name: name,
                desc: desc,
                active: true,
                icon: 'fa-gears',
                color: 'text-purple-400'
            });

            alert(`Dev Plugin '${name}' wurde hinzugefügt und aktiviert!`);
            showSection('plugins');
        }

        // --- AUTHENTICATION & LOGIN ENGINE ---
        function openAuthModal() {
            document.getElementById('auth-modal').classList.remove('hidden');
            document.getElementById('auth-modal').classList.add('flex');
        }

        function closeAuthModal() {
            document.getElementById('auth-modal').classList.add('hidden');
            document.getElementById('auth-modal').classList.remove('flex');
        }

        function handleAuthSubmit(e) {
            e.preventDefault();
            const username = document.getElementById('auth-username').value.trim();
            const email = document.getElementById('auth-email').value.trim();
            const isAdmin = document.getElementById('auth-as-admin').checked;

            currentUser = { loggedIn: true, username: username, email: email, isAdmin: isAdmin };

            document.getElementById('user-display-name').innerText = username;
            document.getElementById('user-status-dot').className = 'w-2 h-2 rounded-full bg-emerald-400';

            document.getElementById('profile-username').innerText = username;
            document.getElementById('profile-email').innerText = email;
            document.getElementById('profile-role').innerText = isAdmin ? 'Administrator & Entwickler' : 'Standard Trader';

            document.getElementById('auth-form').classList.add('hidden');
            document.getElementById('auth-profile-view').classList.remove('hidden');

            closeAuthModal();
        }

        function handleLogout() {
            currentUser = { loggedIn: false, username: '', email: '', isAdmin: false };
            document.getElementById('user-display-name').innerText = 'Anmelden';
            document.getElementById('user-status-dot').className = 'w-2 h-2 rounded-full bg-slate-500';

            document.getElementById('auth-form').classList.remove('hidden');
            document.getElementById('auth-profile-view').classList.add('hidden');
            closeAuthModal();
        }

        function startLiveClock() {
            setInterval(() => {
                const now = new Date();
                document.getElementById('live-seconds-clock').innerText = now.toTimeString().split(' ')[0];
            }, 1000);
        }

        function resetRefreshTimer() {
            if (refreshTimerInterval) clearInterval(refreshTimerInterval);
            const mins = parseInt(document.getElementById('select-refresh-interval').value);
            if (mins === 0) return;
            refreshCountdownSeconds = mins * 60;
            refreshTimerInterval = setInterval(() => {
                refreshCountdownSeconds--;
                if (refreshCountdownSeconds <= 0) startScanner();
                else {
                    const m = Math.floor(refreshCountdownSeconds / 60);
                    const s = refreshCountdownSeconds % 60;
                    document.getElementById('next-refresh-timer').innerText = `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
                }
            }, 1000);
        }

        function changeAutoRefreshRate() {
            resetRefreshTimer();
        }

        window.onload = function() {
            startLiveClock();
            renderPluginsGrid();
            startScanner();
        };
    </script>
</body>
</html>
